# Agni server configuration. Copy to .env at the repo root.
# Bun loads .env automatically. Everything here is gitignored except this file.

# --- server ---
AGNI_HOST=127.0.0.1          # dev: loopback. On bb-1: the Tailscale 100.x address.
AGNI_PORT=8787
AGNI_DB_PATH=data/agni.sqlite
# AGNI_LOG_LEVEL=info        # debug | info | warn | error

# --- daemon (`bun run daemon …`) ---
# AGNI_PID_PATH=data/agni.pid
# AGNI_LOG_PATH=data/agni.log
# AGNI_JOB_POLL_MS=3000      # how often the job runner looks for due work
# AGNI_MAX_CONCURRENT_TURNS=4 # maximum simultaneous provider streams

# --- model providers (all OpenAI-compatible; a provider is enabled by its key) ---
# Any provider's endpoint can be overridden with <NAME>_BASE_URL (proxies,
# self-hosted NIM, tests).
# Instant lane, free tier, very fast:
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama3.1-8b

# Your existing NIM key; task lane and failover:
# NVIDIA_API_KEY=nvapi-…
# NIM_MODEL=meta/llama-3.3-70b-instruct

# Free tier; deep lane:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# `:free` models; deep lane:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local, offline (LM Studio on this Mac). Enabled by setting LMSTUDIO_MODEL.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=

# --- plugins (Google OAuth) ---
# Create one Google Cloud project per docs/plugins-plan.html §3: OAuth consent
# screen → External user type → publishing status "In production" (leave it
# unverified — that is what keeps refresh tokens alive past 7 days) → an
# OAuth client ID of type "Desktop app", with redirect URI
# `http://127.0.0.1:8787/oauth/callback` in the client's allowed list.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Gmail app password (simpler auth, requires 2FA on the account) ---
# For the agent's own mailbox: enable 2-Step Verification, then create an app
# password at https://myaccount.google.com/apppasswords. Paste the 16-char code.
# GMAIL_USER=hey.agnibot@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- web search (Firecrawl first, all free) ---
# Firecrawl is the primary search + scrape provider.
# Self-hosted (open source, unlimited, runs locally):
#   git clone --depth 1 https://github.com/mendableai/firecrawl.git apps/firecrawl
#   cd apps/firecrawl && docker compose up -d
#   AGNI_FIRECRAWL_URL=http://localhost:3002
# Cloud free tier (500 credits/mo):
#   Sign up at https://firecrawl.dev → get API key
#   AGNI_FIRECRAWL_API_KEY=fc-...
# Optional: SearXNG (self-hosted meta-search, best quality)
# AGNI_SEARXNG_URL=http://127.0.0.1:8080
# Zero-config fallback: DuckDuckGo Instant Answer (no setup needed)

# --- timing / budgets ---
# AGNI_FIRST_TOKEN_TIMEOUT_MS=3000
# AGNI_TURN_TIMEOUT_MS=30000

# --- context and memory (TUNABLE; the defaults are starting guesses) ---
# The confidence floor for automatic retrieval: below it, nothing is injected.
# AGNI_MIN_RECALL_SCORE=0.15
# The context assembler's slot budgets, in tokens.
# AGNI_SLOT_PINNED_CORE=1500
# AGNI_SLOT_ANCHOR=200
# AGNI_SLOT_LEDGER=800
# AGNI_SLOT_SUMMARIES=1500
# AGNI_SLOT_RECALL=1500
